NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

DATABASE_URL=postgresql://aurora:aurora@localhost:5432/aurora?schema=public
DATABASE_CONNECT_ON_BOOT=true
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_ON_BOOT=true

LOG_LEVEL=info
AUTH_TOKEN_SECRET=replace-with-at-least-16-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_DEV_LOGIN_ENABLED=true
INITIAL_POINTS=100
CHAT_POINTS_COST=1
IMAGE_TASK_POINTS_COST=5

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=openai-gpt-6-astra
LLM_MOCK_MODE=false
LLM_REQUEST_TIMEOUT_MS=120000

STORAGE_ROOT=../../storage
FILE_MAX_SIZE_BYTES=10485760
