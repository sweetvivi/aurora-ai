NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

DATABASE_URL=postgresql://aurora:aurora@localhost:5432/aurora?schema=public
DATABASE_CONNECT_ON_BOOT=true
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_ON_BOOT=true

LOG_LEVEL=info
AUTH_TOKEN_SECRET=replace-with-at-least-16-random-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_DEV_LOGIN_ENABLED=true
INITIAL_POINTS=100
CHAT_POINTS_COST=1
IMAGE_TASK_POINTS_COST=5

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_DEEPSEEK_BASE_URL=https://api.example.com/v1
LLM_DEEPSEEK_API_KEY=
LLM_DEFAULT_MODEL=openai-gpt-6-astra
LLM_MOCK_MODE=false
LLM_QWEN_BASE_URL=https://api.example.com/v1
LLM_QWEN_API_KEY=
LLM_REQUEST_TIMEOUT_MS=120000

STORAGE_ROOT=../../storage
FILE_MAX_SIZE_BYTES=10485760
VIDEO_FILE_MAX_SIZE_BYTES=52428800
IMAGE_MOCK_DELAY_MS=1200
IMAGE_MOCK_IMAGE_SIZE=512
IMAGE_PROVIDER=auto
IMAGE_BASE_URL=https://api.example.com/v1
IMAGE_API_KEY=
IMAGE_FALLBACK_API_KEY=
IMAGE_SEEDREAM_API_KEY=
IMAGE_ACTOR_AUTHORIZATION=local-image-extension
IMAGE_DEFAULT_MODEL=gpt-image-2.5
IMAGE_DEFAULT_MODEL_ALIAS=jiguang-gpt-image-2.5
IMAGE_SEEDREAM_DEFAULT_MODEL=doubao-seedream-4-0-250828
IMAGE_REQUEST_TIMEOUT_MS=180000

VIDEO_TASK_POINTS_COST=10
VIDEO_PROVIDER=auto
VIDEO_BASE_URL=https://api.example.com/v1
VIDEO_API_KEY=
VIDEO_SEEDANCE_API_KEY=
VIDEO_DEFAULT_MODEL=grok-imagine-video
VIDEO_DEFAULT_MODEL_ALIAS=xai-grok-imagine-video
VIDEO_SEEDANCE_DEFAULT_MODEL=doubao-seedance-1-0-pro-250528
VIDEO_REQUEST_TIMEOUT_MS=180000
VIDEO_POLL_INTERVAL_MS=2000
VIDEO_MAX_POLL_DURATION_MS=900000
VIDEO_MOCK_DURATION_MS=4000
VIDEO_RESULT_MAX_BYTES=314572800
