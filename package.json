{
  "name": "aurora-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @aurora/web --filter @aurora/api dev",
    "dev:api": "pnpm --filter @aurora/api dev",
    "dev:web": "pnpm --filter @aurora/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:up": "docker compose up -d postgres redis",
    "lint": "oxlint apps --deny-warnings",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
