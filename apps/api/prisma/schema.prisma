generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProviderKind {
  OPENAI_COMPATIBLE
}

enum ModelCapability {
  CHAT
  VISION
  IMAGE
  VIDEO
  EMBEDDING
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT
}

enum MessageStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PointsEntryType {
  GRANT
  HOLD
  SETTLE
  REFUND
  ADJUSTMENT
}

enum PointsReservationStatus {
  RESERVED
  SETTLED
  REFUNDED
}

enum ChatRequestStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  REFUNDED
}

enum FileAssetStatus {
  READY
  DELETED
}

enum ImageTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum VideoTaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CustomAgentStatus {
  DRAFT
  PUBLISHED
}

model ProviderConfig {
  id          String        @id @default(cuid())
  code        String        @unique
  displayName String
  kind        ProviderKind  @default(OPENAI_COMPATIBLE)
  baseUrl     String
  keyRef      String
  priority    Int           @default(100)
  enabled     Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  models      ModelConfig[]

  @@map("provider_configs")
}

model ModelConfig {
  id            String            @id @default(cuid())
  alias         String            @unique
  providerModel String
  displayName   String
  capabilities  ModelCapability[]
  contextWindow Int?
  enabled       Boolean           @default(true)
  providerId    String
  provider      ProviderConfig    @relation(fields: [providerId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([providerId])
  @@map("model_configs")
}

model ModuleDisplayConfig {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  icon            String
  cover           String?
  coverStorageKey String?
  group           String   @default("primary")
  badge           String?
  route           String
  sortOrder       Int      @default(100)
  visible         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([group, sortOrder])
  @@map("module_display_configs")
}

model User {
  id              String              @id @default(cuid())
  email           String?             @unique
  displayName     String
  passwordHash    String?
  role            UserRole            @default(USER)
  status          UserStatus          @default(ACTIVE)
  pointsBalance   Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  refreshSessions RefreshSession[]
  pointsEntries   PointsLedgerEntry[]
  reservations    PointsReservation[]
  conversations   Conversation[]
  messages        Message[]
  chatRequests    ChatRequest[]
  fileAssets      FileAsset[]
  imageTasks      ImageTask[]
  videoTasks      VideoTask[]
  customAgents    CustomAgent[]
  canvasWorkflows CanvasWorkflow[]

  @@index([createdAt])
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_sessions")
}

model PointsLedgerEntry {
  id             String          @id @default(cuid())
  userId         String
  type           PointsEntryType
  delta          Int
  balanceAfter   Int
  idempotencyKey String          @unique
  referenceType  String?
  referenceId    String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("points_ledger_entries")
}

model PointsReservation {
  id             String                  @id @default(cuid())
  userId         String
  amount         Int
  status         PointsReservationStatus @default(RESERVED)
  idempotencyKey String                  @unique
  referenceType  String
  referenceId    String
  expiresAt      DateTime
  settledAt      DateTime?
  refundedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([referenceType, referenceId])
  @@map("points_reservations")
}

model Conversation {
  id            String             @id @default(cuid())
  userId        String
  title         String             @default("新对话")
  modelAlias    String
  status        ConversationStatus @default(ACTIVE)
  lastMessageAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages      Message[]
  chatRequests  ChatRequest[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  userId         String
  role           MessageRole
  content        String              @db.Text
  status         MessageStatus       @default(COMPLETED)
  requestId      String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String    @id @default(cuid())
  messageId String
  fileId    String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file      FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([messageId, fileId])
  @@index([fileId])
  @@map("message_attachments")
}

model ChatRequest {
  id                 String            @id @default(cuid())
  userId             String
  conversationId     String
  userMessageId      String
  assistantMessageId String?
  modelAlias         String
  idempotencyKey     String            @unique
  pointsCost         Int
  status             ChatRequestStatus @default(PENDING)
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime          @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@map("chat_requests")
}

model FileAsset {
  id                  String              @id @default(cuid())
  userId              String
  storageKey          String              @unique
  originalName        String
  mimeType            String
  size                Int
  checksum            String
  status              FileAssetStatus     @default(READY)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceImageTasks    ImageTask[]         @relation("ImageTaskSource")
  resultImageTasks    ImageTask[]         @relation("ImageTaskResult")
  videoSourceTasks    VideoTask[]         @relation("VideoTaskSourceFrame")
  videoLastFrameTasks VideoTask[]         @relation("VideoTaskLastFrame")
  videoReferenceTasks VideoTask[]         @relation("VideoTaskReference")
  videoResultTasks    VideoTask[]         @relation("VideoTaskResult")
  messageAttachments  MessageAttachment[]

  @@index([userId, createdAt])
  @@map("file_assets")
}

model ImageTask {
  id             String          @id @default(cuid())
  userId         String
  sourceFileId   String?
  resultFileId   String?
  modelAlias     String
  prompt         String          @db.Text
  parameters     Json?
  status         ImageTaskStatus @default(QUEUED)
  idempotencyKey String          @unique
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFile     FileAsset?      @relation("ImageTaskSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  resultFile     FileAsset?      @relation("ImageTaskResult", fields: [resultFileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("image_tasks")
}

model VideoTask {
  id                String          @id @default(cuid())
  userId            String
  sourceFileId      String?
  lastFrameFileId   String?
  referenceVideoFileId String?
  resultFileId      String?
  modelAlias        String
  prompt            String          @db.Text
  parameters        Json?
  status            VideoTaskStatus @default(QUEUED)
  providerRequestId String?
  progress          Int             @default(0)
  idempotencyKey    String          @unique
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime        @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFile        FileAsset?      @relation("VideoTaskSourceFrame", fields: [sourceFileId], references: [id], onDelete: SetNull)
  lastFrameFile     FileAsset?      @relation("VideoTaskLastFrame", fields: [lastFrameFileId], references: [id], onDelete: SetNull)
  referenceVideoFile FileAsset?      @relation("VideoTaskReference", fields: [referenceVideoFileId], references: [id], onDelete: SetNull)
  resultFile        FileAsset?      @relation("VideoTaskResult", fields: [resultFileId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([referenceVideoFileId])
  @@map("video_tasks")
}

model CustomAgent {
  id             String            @id
  userId         String
  status         CustomAgentStatus @default(DRAFT)
  name           String
  description    String            @default("")
  instructions   String            @default("") @db.Text
  opening        String            @default("")
  category       String            @default("我的智能体")
  capabilities   String[]
  tags           String[]
  starterPrompts String[]
  color          String            @default("#3979ed")
  glyph          String
  rating         Float             @default(5)
  usage          Int               @default(0)
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@map("custom_agents")
}

model CanvasWorkflow {
  id        String   @id
  userId    String
  title     String   @default("新建画布")
  document  Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("canvas_workflows")
}
